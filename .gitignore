# --- OS cruft ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Microsoft Office lock / autorecover files ---
# Word, Excel, PowerPoint owner-lock files created while a doc is open.
~$*
*.tmp
*.wbk
*.asd
*.xlk
~WRL*.tmp

# --- LibreOffice / OpenOffice ---
.~lock.*#
*.bak

# --- Editors ---
*.swp
*.swo
*~
.vscode/
.idea/

# --- Credentials: never commit these to an evidence repo ---
# Evidence collection makes it easy to drag in a real secret by accident.
*.pem
*.key
*.p12
*.pfx
*.keytab
.env
.env.*
!.env.example
credentials.json
secrets.y*ml

# --- Bulk exports / scratch ---
# Zip/tar of the repo itself, dumped SIEM exports, etc.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Placeholders that hold empty directories must stay tracked.
!.gitkeep
